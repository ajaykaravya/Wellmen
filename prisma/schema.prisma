generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String?           @unique
  createdAt        DateTime          @default(now())
  fullName         String
  passwordHash     String
  roleId           String
  updatedAt        DateTime          @updatedAt
  username         String?           @unique
  firstName        String
  lastName         String
  mobileNumber     String            @unique
  dailyReports     DailyReport[]     @relation("DailyReportCreator")
  createdProjects  Project[]         @relation("ProjectCreator")
  queryManagements QueryManagement[] @relation("QueryCreatedBy")
  assignedTodos    Todo[]            @relation("TodoAssignee")
  createdTodos     Todo[]            @relation("TodoCreator")
  role             Role              @relation(fields: [roleId], references: [id])
}

model Todo {
  id          String     @id @default(uuid())
  description String?
  comments    String?
  startDate   DateTime
  endDate     DateTime?
  status      TodoStatus @default(TODO)
  projectId   String?
  assigneeId  String?
  type        TaskType
  priority    Priority
  categoryId  String
  subCategory String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignee    User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  category    Categories @relation(fields: [categoryId], references: [id])
  createdBy   User?      @relation("TodoCreator", fields: [createdById], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([type])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId])
}

model Project {
  id               String            @id @default(uuid())
  name             String
  address          String
  city             String?
  contactNumber    String
  email            String?
  startDate        DateTime
  endDate          DateTime?
  description      String?
  status           ProjectStatus     @default(PENDING)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyReports     DailyReport[]
  createdBy        User?             @relation("ProjectCreator", fields: [createdById], references: [id])
  queryManagements QueryManagement[]
  todos            Todo[]
}

model DailyReport {
  id          String      @id @default(uuid())
  reportDate  DateTime
  projectId   String
  categoryId  String?
  description String
  imageUrls   Json?
  videoUrls   Json?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Categories? @relation(fields: [categoryId], references: [id])
  createdBy   User?       @relation("DailyReportCreator", fields: [createdById], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdById, reportDate])
  @@index([projectId, reportDate])
  @@index([categoryId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Categories {
  id        String        @id @default(uuid())
  category  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  reports   DailyReport[]
  todos     Todo[]

  @@unique([category, name])
}

model QueryManagement {
  id          String        @id @default(uuid())
  projectId   String
  category    QueryCategory
  description String
  status      QueryStatus   @default(PENDING)
  priority    Priority
  imageUrls   Json?
  videoUrls   Json?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("QueryCreatedBy", fields: [createdById], references: [id])
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum TaskType {
  PROJECT
  OFFICE
  SERVICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum QueryCategory {
  REMARKS
  URGENCY
  DECISION_PENDING
}

enum QueryStatus {
  PENDING
  COMPLETED
}
