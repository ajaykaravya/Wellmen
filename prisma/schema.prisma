generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                             String               @id @default(uuid()) @db.Char(36)
  email                          String?              @unique
  createdAt                      DateTime             @default(now())
  fullName                       String
  passwordHash                   String
  roleId                         String               @db.Char(36)
  updatedAt                      DateTime             @updatedAt
  username                       String?              @unique
  firstName                      String
  lastName                       String
  mobileNumber                   String               @unique
  dailyReports                   DailyReport[]        @relation("DailyReportCreator")
  createdProjects                Project[]            @relation("ProjectCreator")
  queryManagements               QueryManagement[]    @relation("QueryCreatedBy")
  assignedTodos                  Todo[]               @relation("TodoAssignee")
  createdTodos                   Todo[]               @relation("TodoCreator")
  financeTransactionsAsExpenseBy FinanceTransaction[] @relation("FinanceTransactionExpenseBy")
  petiCashGivenBy                PetiCash[]           @relation("PetiCashGivenBy")
  petiCashGivenTo                PetiCash[]           @relation("PetiCashGivenTo")
  incomeTransactionsAsReceivedBy IncomeTransaction[]  @relation("IncomeTransactionReceivedBy")
  transportLogsCreated           TransportLog[]       @relation("TransportLogCreator")
  deviceTokens                   DeviceToken[]
  role                           Role                 @relation(fields: [roleId], references: [id])
}

model Todo {
  id            String     @id @default(uuid()) @db.Char(36)
  description   String?
  comments      String?
  startDate     DateTime
  endDate       DateTime?
  completedDate DateTime?
  status        TodoStatus @default(TODO)
  projectId     String?    @db.Char(36)
  assigneeId    String?    @db.Char(36)
  type          TaskType
  priority      Priority
  categoryId    String     @db.Char(36)
  subCategory   String?
  createdById   String?    @db.Char(36)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignee      User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  category      Categories @relation(fields: [categoryId], references: [id])
  createdBy     User?      @relation("TodoCreator", fields: [createdById], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])

  @@index([type])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId])
  @@index([completedDate])
}

model Project {
  id                   String               @id @default(uuid()) @db.Char(36)
  name                 String
  address              String
  city                 String?
  contactNumber        String
  email                String?
  startDate            DateTime
  endDate              DateTime?
  description          String?
  status               ProjectStatus        @default(PENDING)
  createdById          String?              @db.Char(36)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  dailyReports         DailyReport[]
  financeTransactions  FinanceTransaction[] @relation("FinanceTransactionProject")
  petiCashTransactions PetiCash[]           @relation("PetiCashProject")
  incomeTransactions   IncomeTransaction[]  @relation("IncomeTransactionProject")
  createdBy            User?                @relation("ProjectCreator", fields: [createdById], references: [id])
  queryManagements     QueryManagement[]
  todos                Todo[]
}

model DailyReport {
  id          String      @id @default(uuid()) @db.Char(36)
  reportDate  DateTime
  projectId   String      @db.Char(36)
  categoryId  String?     @db.Char(36)
  description String
  imageUrls   Json?       @db.Json
  videoUrls   Json?       @db.Json
  createdById String?     @db.Char(36)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Categories? @relation(fields: [categoryId], references: [id])
  createdBy   User?       @relation("DailyReportCreator", fields: [createdById], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdById, reportDate])
  @@index([projectId, reportDate])
  @@index([categoryId])
}

model Role {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique
  rolePermissions RolePermission[]
  users           User[]
}

model Company {
  id                                  String               @id @default(uuid()) @db.Char(36)
  name                                String               @unique
  code                                String               @unique
  createdAt                           DateTime             @default(now())
  updatedAt                           DateTime             @updatedAt
  financeTransactionsAsExpenseCompany FinanceTransaction[] @relation("FinanceTransactionExpenseCompany")
  petiCashTransactions                PetiCash[]           @relation("PetiCashCompany")
  incomeTransactionsAsIncomeCompany   IncomeTransaction[]  @relation("IncomeTransactionIncomeCompany")
}

model Permission {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Categories {
  id        String        @id @default(uuid()) @db.Char(36)
  category  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  reports   DailyReport[]
  todos     Todo[]

  @@unique([category, name])
}

model ExpenseType {
  id                   String               @id @default(uuid()) @db.Char(36)
  name                 String               @unique
  status               ExpenseTypeStatus    @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  financeTransactions  FinanceTransaction[] @relation("FinanceTransactionExpenseType")
  petiCashTransactions PetiCash[]           @relation("PetiCashExpenseType")

  @@index([status])
}

model IncomeType {
  id                 String              @id @default(uuid()) @db.Char(36)
  name               String              @unique
  status             ExpenseTypeStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  incomeTransactions IncomeTransaction[] @relation("IncomeTransactionIncomeType")

  @@index([status])
}

model FinanceTransaction {
  id               String           @id @default(uuid()) @db.Char(36)
  transactionType  TransactionType  @default(EXPENSE)
  amount           Decimal          @db.Decimal(14, 2)
  expenseTypeId    String?          @db.Char(36)
  expenseById      String?          @db.Char(36)
  expenseCompanyId String?          @db.Char(36)
  projectId        String?          @db.Char(36)
  paymentMode      CashPaymentMode?
  date             DateTime
  remark           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expenseType      ExpenseType?     @relation("FinanceTransactionExpenseType", fields: [expenseTypeId], references: [id], onDelete: SetNull)
  expenseBy        User?            @relation("FinanceTransactionExpenseBy", fields: [expenseById], references: [id], onDelete: SetNull)
  expenseCompany   Company?         @relation("FinanceTransactionExpenseCompany", fields: [expenseCompanyId], references: [id], onDelete: SetNull)
  project          Project?         @relation("FinanceTransactionProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([transactionType])
  @@index([date])
  @@index([expenseTypeId])
  @@index([expenseById])
  @@index([expenseCompanyId])
  @@index([projectId])
  @@index([paymentMode])
}

model PetiCash {
  id              String                  @id @default(uuid()) @db.Char(36)
  amount          Decimal                 @db.Decimal(14, 2)
  transactionType PetiCashTransactionType
  givenById       String?                 @db.Char(36)
  givenToId       String?                 @db.Char(36)
  companyId       String?                 @db.Char(36)
  projectId       String?                 @db.Char(36)
  expenseTypeId   String?                 @db.Char(36)
  date            DateTime
  remarks         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  givenBy         User?                   @relation("PetiCashGivenBy", fields: [givenById], references: [id], onDelete: SetNull)
  givenTo         User?                   @relation("PetiCashGivenTo", fields: [givenToId], references: [id], onDelete: SetNull)
  company         Company?                @relation("PetiCashCompany", fields: [companyId], references: [id], onDelete: SetNull)
  project         Project?                @relation("PetiCashProject", fields: [projectId], references: [id], onDelete: SetNull)
  expenseType     ExpenseType?            @relation("PetiCashExpenseType", fields: [expenseTypeId], references: [id], onDelete: SetNull)

  @@index([transactionType])
  @@index([date])
  @@index([givenById])
  @@index([givenToId])
  @@index([companyId])
  @@index([projectId])
  @@index([expenseTypeId])
}

model IncomeTransaction {
  id              String           @id @default(uuid()) @db.Char(36)
  transactionType TransactionType  @default(INCOME)
  amount          Decimal          @db.Decimal(14, 2)
  incomeTypeId    String?          @db.Char(36)
  incomeCompanyId String?          @db.Char(36)
  receivedById    String?          @db.Char(36)
  projectId       String?          @db.Char(36)
  paymentMode     CashPaymentMode?
  date            DateTime
  remark          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  incomeType      IncomeType?      @relation("IncomeTransactionIncomeType", fields: [incomeTypeId], references: [id], onDelete: SetNull)
  incomeCompany   Company?         @relation("IncomeTransactionIncomeCompany", fields: [incomeCompanyId], references: [id], onDelete: SetNull)
  receivedBy      User?            @relation("IncomeTransactionReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  project         Project?         @relation("IncomeTransactionProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([transactionType])
  @@index([date])
  @@index([incomeTypeId])
  @@index([incomeCompanyId])
  @@index([receivedById])
  @@index([projectId])
  @@index([paymentMode])
}

model TransportLog {
  id                    String        @id @default(uuid()) @db.Char(36)
  serialNo              Int
  transportType         TransportType
  date                  DateTime
  referenceNumber       String?
  description           String?
  locationType          String?
  city                  String?
  floor                 String?
  kmStart               Int           @default(0)
  kmEnd                 Int           @default(0)
  totalKm               Int           @default(0)
  loadType              String?
  driverWages           Decimal       @default(0) @db.Decimal(14, 2)
  otherExpenses         Decimal       @default(0) @db.Decimal(14, 2)
  floorRent             Decimal       @default(0) @db.Decimal(14, 2)
  returnMaterialFreight Decimal       @default(0) @db.Decimal(14, 2)
  fromLocation          String?
  toLocation            String?
  mobileNumber          String?
  noOfCovers            Int           @default(0)
  totalWeight           Decimal       @default(0) @db.Decimal(14, 2)
  weightCharge          Decimal       @default(0) @db.Decimal(14, 2)
  coverCharge           Decimal       @default(0) @db.Decimal(14, 2)
  vehicleNumber         String?
  baseAmount            Decimal       @default(0) @db.Decimal(14, 2)
  gstAmount             Decimal       @default(0) @db.Decimal(14, 2)
  tripType              String?
  tripCharge            Decimal       @default(0) @db.Decimal(14, 2)
  vehicleType           String?
  loadingCharges        Decimal       @default(0) @db.Decimal(14, 2)
  returnMaterialCharges Decimal       @default(0) @db.Decimal(14, 2)
  transportCharges      Decimal       @default(0) @db.Decimal(14, 2)
  paymentMode           String?
  status                String?
  remark                String?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdBy             User?         @relation("TransportLogCreator", fields: [createdById], references: [id])

  @@unique([transportType, serialNo])
  @@index([transportType])
  @@index([date])
  @@index([status])
  @@index([paymentMode])
  @@index([createdById])
}

model TransportConfig {
  id            String              @id @default(uuid()) @db.Char(36)
  transportType TransportType
  configType    TransportConfigType
  configKey     String
  configData    Json
  floor         String?
  loadType      String?
  tripType      String?
  minKm         Int?
  maxKm         Int?
  rate          Decimal             @default(0) @db.Decimal(14, 2)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([transportType, configType, configKey])
  @@index([transportType, configType])
  @@index([isActive])
}

model QueryManagement {
  id          String        @id @default(uuid()) @db.Char(36)
  projectId   String        @db.Char(36)
  category    QueryCategory
  description String
  status      QueryStatus   @default(PENDING)
  priority    Priority
  imageUrls   Json?         @db.Json
  videoUrls   Json?         @db.Json
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("QueryCreatedBy", fields: [createdById], references: [id])
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

model DeviceToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String
  token      String    @unique
  platform   String?
  deviceId   String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum TaskType {
  PROJECT
  OFFICE
  SERVICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum QueryCategory {
  REMARKS
  URGENCY
  DECISION_PENDING
}

enum QueryStatus {
  PENDING
  COMPLETED
}

enum ExpenseTypeStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CashPaymentMode {
  CASH
  BANK
  CHEQUE
  UPI
  NEFT_RTGS
}

enum PetiCashTransactionType {
  CREDIT
  DEBIT
}

enum TransportType {
  BOLERO_DELIVERY
  BOLERO_RETURN_DC
  COURIER_DAILY
  PORTER_DAILY
  CNG_RICKSHAW
  LOADING_VEHICLE
}

enum TransportConfigType {
  DRIVER_WAGE_SLAB
  FLOOR_RENT
  COURIER_WEIGHT_RATE
  COURIER_COVER_RATE
  CNG_TRIP_SLAB
}
