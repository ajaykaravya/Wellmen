generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Todo {
  id            String     @id @default(uuid()) @db.Char(36)
  description   String?
  comments      String?
  startDate     DateTime
  endDate       DateTime?
  completedDate DateTime?
  status        TodoStatus @default(TODO)
  projectId     String?    @db.Char(36)
  assigneeId    String?    @db.Char(36)
  type          TaskType
  priority      Priority
  categoryId    String     @db.Char(36)
  subCategory   String?
  createdById   String?    @db.Char(36)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignee      User?      @relation("Todo_assigneeIdToUser", fields: [assigneeId], references: [id])
  category      Categories @relation(fields: [categoryId], references: [id])
  createdBy     User?      @relation("Todo_createdByIdToUser", fields: [createdById], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])

  @@index([type])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId])
  @@index([completedDate])
  @@index([assigneeId], map: "Todo_assigneeId_fkey")
  @@index([createdById], map: "Todo_createdById_fkey")
}

model Project {
  id                     String                  @id @default(uuid()) @db.Char(36)
  name                   String
  address                String
  city                   String?
  contactNumber          String
  email                  String?
  startDate              DateTime
  endDate                DateTime?
  description            String?
  status                 ProjectStatus           @default(PENDING)
  createdById            String?                 @db.Char(36)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  dailyReports           DailyReport[]
  financeTransactions    FinanceTransaction[]    @relation("FinanceTransactionProject")
  incomeTransactions     IncomeTransaction[]     @relation("IncomeTransactionProject")
  petiCashTransactions   PetiCash[]              @relation("PetiCashProject")
  User                   User?                   @relation(fields: [createdById], references: [id])
  queryManagements       QueryManagement[]
  todos                  Todo[]
  projectFormSubmissions ProjectFormSubmission[]
  drawings               ProjectDrawing[]

  @@index([createdById], map: "Project_createdById_fkey")
}

model DailyReport {
  id          String      @id @default(uuid()) @db.Char(36)
  reportDate  DateTime
  projectId   String      @db.Char(36)
  categoryId  String?     @db.Char(36)
  description String
  imageUrls   Json?
  videoUrls   Json?
  createdById String?     @db.Char(36)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Categories? @relation(fields: [categoryId], references: [id])
  createdBy   User?       @relation(fields: [createdById], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdById, reportDate])
  @@index([projectId, reportDate])
  @@index([categoryId])
}

model Role {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique
  rolePermissions RolePermission[]
  User            User[]
}

model Company {
  id                                  String               @id @default(uuid()) @db.Char(36)
  name                                String               @unique
  code                                String               @unique
  contactPerson                       String?
  contactNumber                       String?
  email                               String?
  address                             String?              @db.Text
  logoUrl                             String?              @db.Text
  isPrimary                           Boolean              @default(false)
  createdAt                           DateTime             @default(now())
  updatedAt                           DateTime             @updatedAt
  financeTransactionsAsExpenseCompany FinanceTransaction[] @relation("FinanceTransactionExpenseCompany")
  incomeTransactionsAsIncomeCompany   IncomeTransaction[]  @relation("IncomeTransactionIncomeCompany")
  petiCashTransactions                PetiCash[]           @relation("PetiCashCompany")

  @@index([isPrimary])
}

model Permission {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model Categories {
  id        String        @id @default(uuid()) @db.Char(36)
  category  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  reports   DailyReport[]
  todos     Todo[]

  @@unique([category, name])
}

model ExpenseType {
  id                   String               @id @default(uuid()) @db.Char(36)
  name                 String               @unique
  status               ExpenseTypeStatus    @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  expenseTypeUsers     ExpenseTypeUser[]
  financeTransactions  FinanceTransaction[] @relation("FinanceTransactionExpenseType")
  petiCashTransactions PetiCash[]           @relation("PetiCashExpenseType")

  @@index([status])
}

model IncomeType {
  id                 String              @id @default(uuid()) @db.Char(36)
  name               String              @unique
  status             ExpenseTypeStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  incomeTransactions IncomeTransaction[] @relation("IncomeTransactionIncomeType")

  @@index([status])
}

model FinanceTransaction {
  id               String           @id @default(uuid()) @db.Char(36)
  transactionType  TransactionType  @default(EXPENSE)
  amount           Decimal          @db.Decimal(14, 2)
  petiCashId       String?          @unique @db.Char(36)
  expenseTypeId    String?          @db.Char(36)
  expenseById      String?          @db.Char(36)
  expenseCompanyId String?          @db.Char(36)
  projectId        String?          @db.Char(36)
  paymentMode      CashPaymentMode?
  date             DateTime
  remark           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expenseBy        User?            @relation(fields: [expenseById], references: [id])
  expenseCompany   Company?         @relation("FinanceTransactionExpenseCompany", fields: [expenseCompanyId], references: [id])
  expenseType      ExpenseType?     @relation("FinanceTransactionExpenseType", fields: [expenseTypeId], references: [id])
  petiCash         PetiCash?        @relation("PetiCashDailyExpense", fields: [petiCashId], references: [id], onDelete: Cascade)
  project          Project?         @relation("FinanceTransactionProject", fields: [projectId], references: [id])

  @@index([transactionType])
  @@index([date])
  @@index([expenseTypeId])
  @@index([expenseById])
  @@index([expenseCompanyId])
  @@index([projectId])
  @@index([petiCashId])
  @@index([paymentMode])
}

model PetiCash {
  id              String                  @id @default(uuid()) @db.Char(36)
  amount          Decimal                 @db.Decimal(14, 2)
  transactionType PetiCashTransactionType
  isAdvance       Boolean?                @default(true)
  givenById       String?                 @db.Char(36)
  givenToId       String?                 @db.Char(36)
  companyId       String?                 @db.Char(36)
  projectId       String?                 @db.Char(36)
  expenseTypeId   String?                 @db.Char(36)
  date            DateTime
  remarks         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  company         Company?                @relation("PetiCashCompany", fields: [companyId], references: [id])
  expenseType     ExpenseType?            @relation("PetiCashExpenseType", fields: [expenseTypeId], references: [id])
  givenBy         User?                   @relation("PetiCash_givenByIdToUser", fields: [givenById], references: [id])
  givenTo         User?                   @relation("PetiCash_givenToIdToUser", fields: [givenToId], references: [id])
  dailyExpense    FinanceTransaction?     @relation("PetiCashDailyExpense")
  project         Project?                @relation("PetiCashProject", fields: [projectId], references: [id])

  @@index([transactionType])
  @@index([date])
  @@index([givenById])
  @@index([givenToId])
  @@index([companyId])
  @@index([projectId])
  @@index([expenseTypeId])
}

model IncomeTransaction {
  id              String           @id @default(uuid()) @db.Char(36)
  transactionType TransactionType  @default(INCOME)
  amount          Decimal          @db.Decimal(14, 2)
  incomeTypeId    String?          @db.Char(36)
  incomeCompanyId String?          @db.Char(36)
  receivedById    String?          @db.Char(36)
  projectId       String?          @db.Char(36)
  paymentMode     CashPaymentMode?
  date            DateTime
  remark          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  incomeCompany   Company?         @relation("IncomeTransactionIncomeCompany", fields: [incomeCompanyId], references: [id])
  incomeType      IncomeType?      @relation("IncomeTransactionIncomeType", fields: [incomeTypeId], references: [id])
  project         Project?         @relation("IncomeTransactionProject", fields: [projectId], references: [id])
  receivedBy      User?            @relation(fields: [receivedById], references: [id])

  @@index([transactionType])
  @@index([date])
  @@index([incomeTypeId])
  @@index([incomeCompanyId])
  @@index([receivedById])
  @@index([projectId])
  @@index([paymentMode])
}

model TransportLog {
  id                    String        @id @default(uuid()) @db.Char(36)
  serialNo              Int
  transportType         TransportType
  date                  DateTime
  referenceNumber       String?
  description           String?
  locationType          String?
  city                  String?
  floor                 String?
  kmStart               Int           @default(0)
  kmEnd                 Int           @default(0)
  totalKm               Int           @default(0)
  loadType              String?
  driverWages           Decimal       @default(0.00) @db.Decimal(14, 2)
  otherExpenses         Decimal       @default(0.00) @db.Decimal(14, 2)
  floorRent             Decimal       @default(0.00) @db.Decimal(14, 2)
  returnMaterialFreight Decimal       @default(0.00) @db.Decimal(14, 2)
  fromLocation          String?
  toLocation            String?
  mobileNumber          String?
  noOfCovers            Int           @default(0)
  totalWeight           Decimal       @default(0.00) @db.Decimal(14, 2)
  weightCharge          Decimal       @default(0.00) @db.Decimal(14, 2)
  coverCharge           Decimal       @default(0.00) @db.Decimal(14, 2)
  vehicleNumber         String?
  baseAmount            Decimal       @default(0.00) @db.Decimal(14, 2)
  gstAmount             Decimal       @default(0.00) @db.Decimal(14, 2)
  tripType              String?
  tripCharge            Decimal       @default(0.00) @db.Decimal(14, 2)
  vehicleType           String?
  loadingCharges        Decimal       @default(0.00) @db.Decimal(14, 2)
  returnMaterialCharges Decimal       @default(0.00) @db.Decimal(14, 2)
  transportCharges      Decimal       @default(0.00) @db.Decimal(14, 2)
  paymentMode           String?
  status                String?
  remark                String?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdBy             User?         @relation(fields: [createdById], references: [id])

  @@unique([transportType, serialNo])
  @@index([transportType])
  @@index([date])
  @@index([status])
  @@index([paymentMode])
  @@index([createdById])
}

model TransportConfig {
  id            String              @id @default(uuid()) @db.Char(36)
  transportType TransportType
  configType    TransportConfigType
  configKey     String
  configData    Json
  floor         String?
  loadType      String?
  tripType      String?
  minKm         Int?
  maxKm         Int?
  rate          Decimal             @default(0.00) @db.Decimal(14, 2)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([transportType, configType, configKey])
  @@index([transportType, configType])
  @@index([isActive])
}

model QueryManagement {
  id          String        @id @default(uuid()) @db.Char(36)
  projectId   String        @db.Char(36)
  category    QueryCategory
  description String
  status      QueryStatus   @default(PENDING)
  priority    Priority
  imageUrls   Json?
  videoUrls   Json?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation(fields: [createdById], references: [id])
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

model DeviceToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String
  token      String    @unique
  platform   String?
  deviceId   String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model ProjectForm {
  id        String  @id @default(uuid()) @db.Char(36)
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(999)

  template Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  submissions ProjectFormSubmission[]
}

model ProjectFormSubmission {
  id            String     @id @default(uuid()) @db.Char(36)
  projectId     String     @db.Char(36)
  projectFormId String     @db.Char(36)
  status        FormStatus @default(PENDING)
  formData      Json?
  submittedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectForm ProjectForm @relation(fields: [projectFormId], references: [id], onDelete: Cascade)

  @@unique([projectId, projectFormId])
}

model User {
  id                                String               @id @default(uuid()) @db.Char(36)
  email                             String?              @unique
  createdAt                         DateTime             @default(now())
  fullName                          String
  passwordHash                      String
  roleId                            String               @db.Char(36)
  updatedAt                         DateTime             @updatedAt
  username                          String?              @unique
  firstName                         String
  lastName                          String
  mobileNumber                      String               @unique
  DailyReport                       DailyReport[]
  DeviceToken                       DeviceToken[]
  FinanceTransaction                FinanceTransaction[]
  IncomeTransaction                 IncomeTransaction[]
  PetiCash_PetiCash_givenByIdToUser PetiCash[]           @relation("PetiCash_givenByIdToUser")
  PetiCash_PetiCash_givenToIdToUser PetiCash[]           @relation("PetiCash_givenToIdToUser")
  expenseTypeUsers                  ExpenseTypeUser[]
  Project                           Project[]
  QueryManagement                   QueryManagement[]
  assignedTodos                     Todo[]               @relation("Todo_assigneeIdToUser")
  createdTodos                      Todo[]               @relation("Todo_createdByIdToUser")
  TransportLog                      TransportLog[]
  projectDrawings                   ProjectDrawing[]
  role                              Role                 @relation(fields: [roleId], references: [id])

  @@index([roleId], map: "User_roleId_fkey")
}

model ExpenseTypeUser {
  expenseTypeId String      @db.Char(36)
  userId        String      @db.Char(36)
  expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseTypeId, userId])
  @@index([userId], map: "ExpenseTypeUser_userId_fkey")
}

model DrawingCategory {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawings ProjectDrawing[]

  @@index([isActive])
  @@index([sortOrder])
}

model ProjectDrawing {
  id                String          @id @default(uuid()) @db.Char(36)
  projectId         String          @db.Char(36)
  drawingCategoryId String          @db.Char(36)
  fileType          DrawingFileType
  fileUrl           String          @db.Text
  fileName          String
  fileSize          Int?
  uploadedById      String?         @db.Char(36)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingCategory DrawingCategory @relation(fields: [drawingCategoryId], references: [id])
  uploadedBy      User?           @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([drawingCategoryId])
  @@index([fileType])
  @@index([uploadedById], map: "ProjectDrawing_uploadedById_fkey")
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum TaskType {
  PROJECT
  OFFICE
  SERVICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum QueryCategory {
  REMARKS
  URGENCY
  DECISION_PENDING
}

enum QueryStatus {
  PENDING
  COMPLETED
}

enum ExpenseTypeStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CashPaymentMode {
  CASH
  BANK
  CHEQUE
  UPI
  NEFT_RTGS
}

enum PetiCashTransactionType {
  CREDIT
  DEBIT
}

enum TransportType {
  BOLERO_DELIVERY
  BOLERO_RETURN_DC
  COURIER_DAILY
  PORTER_DAILY
  CNG_RICKSHAW
  LOADING_VEHICLE
}

enum TransportConfigType {
  DRIVER_WAGE_SLAB
  FLOOR_RENT
  COURIER_WEIGHT_RATE
  COURIER_COVER_RATE
  CNG_TRIP_SLAB
}

enum FormStatus {
  PENDING
  COMPLETED
}

enum DrawingFileType {
  PDF
  PPT
  IMAGE
  AUTOCAD
}
