generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String?           @unique
  createdAt        DateTime          @default(now())
  fullName         String
  passwordHash     String
  roleId           String
  updatedAt        DateTime          @updatedAt
  username         String?           @unique
  firstName        String
  lastName         String
  mobileNumber     String            @unique
  dailyReports     DailyReport[]     @relation("DailyReportCreator")
  createdProjects  Project[]         @relation("ProjectCreator")
  queryManagements QueryManagement[] @relation("QueryCreatedBy")
  assignedTodos    Todo[]            @relation("TodoAssignee")
  createdTodos     Todo[]            @relation("TodoCreator")
  transportLogsCreated TransportLog[] @relation("TransportLogCreator")
  deviceTokens     DeviceToken[]
  role             Role              @relation(fields: [roleId], references: [id])
}

model Todo {
  id          String     @id @default(uuid())
  description String?
  comments    String?
  startDate   DateTime
  endDate     DateTime?
  completedDate DateTime?
  status      TodoStatus @default(TODO)
  projectId   String?
  assigneeId  String?
  type        TaskType
  priority    Priority
  categoryId  String
  subCategory String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignee    User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  category    Categories @relation(fields: [categoryId], references: [id])
  createdBy   User?      @relation("TodoCreator", fields: [createdById], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([type])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId])
  @@index([completedDate])
}

model Project {
  id               String            @id @default(uuid())
  name             String
  address          String
  city             String?
  contactNumber    String
  email            String?
  startDate        DateTime
  endDate          DateTime?
  description      String?
  status           ProjectStatus     @default(PENDING)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyReports     DailyReport[]
  createdBy        User?             @relation("ProjectCreator", fields: [createdById], references: [id])
  queryManagements QueryManagement[]
  todos            Todo[]
}

model DailyReport {
  id          String      @id @default(uuid())
  reportDate  DateTime
  projectId   String
  categoryId  String?
  description String
  imageUrls   Json?
  videoUrls   Json?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Categories? @relation(fields: [categoryId], references: [id])
  createdBy   User?       @relation("DailyReportCreator", fields: [createdById], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdById, reportDate])
  @@index([projectId, reportDate])
  @@index([categoryId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
  users           User[]
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Categories {
  id        String        @id @default(uuid())
  category  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  reports   DailyReport[]
  todos     Todo[]

  @@unique([category, name])
}

model ExpenseType {
  id            String           @id @default(uuid())
  name          String           @unique
  status        ExpenseTypeStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dailyExpenses DailyExpense[]

  @@index([status])
}

model DailyExpense {
  id              String         @id @default(uuid())
  transactionType TransactionType
  amount          Decimal        @db.Decimal(14, 2)
  expenseTypeId   String?
  date            DateTime
  remark          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expenseType     ExpenseType?   @relation(fields: [expenseTypeId], references: [id], onDelete: SetNull)

  @@index([transactionType])
  @@index([date])
  @@index([expenseTypeId])
}

model TransportLog {
  id                    String        @id @default(uuid())
  serialNo              Int
  transportType         TransportType
  date                  DateTime
  referenceNumber       String?
  description           String?
  locationType          String?
  city                  String?
  floor                 String?
  kmStart               Int           @default(0)
  kmEnd                 Int           @default(0)
  totalKm               Int           @default(0)
  loadType              String?
  driverWages           Decimal       @default(0) @db.Decimal(14, 2)
  otherExpenses         Decimal       @default(0) @db.Decimal(14, 2)
  floorRent             Decimal       @default(0) @db.Decimal(14, 2)
  returnMaterialFreight Decimal       @default(0) @db.Decimal(14, 2)
  fromLocation          String?
  toLocation            String?
  mobileNumber          String?
  noOfCovers            Int           @default(0)
  totalWeight           Decimal       @default(0) @db.Decimal(14, 2)
  weightCharge          Decimal       @default(0) @db.Decimal(14, 2)
  coverCharge           Decimal       @default(0) @db.Decimal(14, 2)
  vehicleNumber         String?
  baseAmount            Decimal       @default(0) @db.Decimal(14, 2)
  gstAmount             Decimal       @default(0) @db.Decimal(14, 2)
  tripType              String?
  tripCharge            Decimal       @default(0) @db.Decimal(14, 2)
  vehicleType           String?
  loadingCharges        Decimal       @default(0) @db.Decimal(14, 2)
  returnMaterialCharges Decimal       @default(0) @db.Decimal(14, 2)
  transportCharges      Decimal       @default(0) @db.Decimal(14, 2)
  paymentMode           String?
  status                String?
  remark                String?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdBy             User?         @relation("TransportLogCreator", fields: [createdById], references: [id])

  @@unique([transportType, serialNo])
  @@index([transportType])
  @@index([date])
  @@index([status])
  @@index([paymentMode])
  @@index([createdById])
}

model TransportConfig {
  id           String              @id @default(uuid())
  transportType TransportType
  configType   TransportConfigType
  configKey    String
  configData   Json
  floor        String?
  loadType     String?
  tripType     String?
  minKm        Int?
  maxKm        Int?
  rate         Decimal             @default(0) @db.Decimal(14, 2)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([transportType, configType, configKey])
  @@index([transportType, configType])
  @@index([isActive])
}

model QueryManagement {
  id          String        @id @default(uuid())
  projectId   String
  category    QueryCategory
  description String
  status      QueryStatus   @default(PENDING)
  priority    Priority
  imageUrls   Json?
  videoUrls   Json?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("QueryCreatedBy", fields: [createdById], references: [id])
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  deviceId   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum TaskType {
  PROJECT
  OFFICE
  SERVICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum QueryCategory {
  REMARKS
  URGENCY
  DECISION_PENDING
}

enum QueryStatus {
  PENDING
  COMPLETED
}

enum ExpenseTypeStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransportType {
  BOLERO_DELIVERY
  BOLERO_RETURN_DC
  COURIER_DAILY
  PORTER_DAILY
  CNG_RICKSHAW
  LOADING_VEHICLE
}

enum TransportConfigType {
  DRIVER_WAGE_SLAB
  FLOOR_RENT
  COURIER_WEIGHT_RATE
  COURIER_COVER_RATE
  CNG_TRIP_SLAB
}
